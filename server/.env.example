OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nova_pipeline
API_KEY=your_pipeline_api_key_here

# Optional IMAP source adapter for scripts/imap_trigger.py
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your_email@example.com
IMAP_PASSWORD=your_app_password_here
IMAP_FOLDER=INBOX
IMAP_SEARCH_CRITERIA=UNSEEN
IMAP_MARK_SEEN=true
IMAP_POLL_INTERVAL_SECONDS=60

# Optional outbound email. If SMTP_USERNAME/PASSWORD are omitted, the app falls
# back to IMAP_USERNAME/IMAP_PASSWORD when SMTP_ENABLED=true.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@example.com
SMTP_USE_TLS=true
